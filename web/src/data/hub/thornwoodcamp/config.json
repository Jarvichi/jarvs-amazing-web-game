  "npcs": [
    {
      "id": "warden-rell",
      "name": "Warden Rell",
      "dialogueTree": "rell-pie-trade",
      "sprite": "hub-npc-soldier",
      "tx": 11,
      "ty": 10,
      "dialogue": [
        "Thornwood Camp. Last warm fire between Ironhold and the river.",
        "I keep the fire and the fire keeps the wolves honest. Simple arrangement.",
        "Firewood's running low again. The forest gives, but only if you go and fetch."
      ],
      "conversationTopics": ["thornwoodcamp-warden-rell-topic-auto-1", "thornwoodcamp-warden-rell-topic-auto-2", "thornwoodcamp-warden-rell-topic-auto-3"],
      "questGive": "thornwood-embers-low",
      "questReceive": [
        "thornwood-embers-low",
        "thornwood-snare-line",
        "thornwood-wolf-watch-2"
      ],
      "favoriteGiftItemId": "sturdy-boots",
      "favoriteGiftTrack": "ally",
      "dislikedGiftItemIds": [
        "pressed-flower"
      ]
    },
    {
      "id": "forager-mott",
      "name": "Forager Mott",
      "dialogueTree": "mott-herring-trade",
      "sprite": "hub-npc-supplies",
      "tx": 14,
      "ty": 45,
      "dialogue": [
        "Don't mind the rocks — landslide brought half the ridge down across the path. I've been stuck on this side for two days.",
        "There's queer little stones in the scree where it fell. Bring me a few and I'll shift the blockage; my hands know which ones hold the wall.",
        "Warden Rell's up by the fire, if you can get past. Tell him Mott's alive, would you?"
      ],
      "conversationTopics": ["thornwoodcamp-forager-mott-topic-auto-1", "thornwoodcamp-forager-mott-topic-auto-2", "thornwoodcamp-forager-mott-topic-auto-3"],
      "questGive": "thornwood-lost-treeline",
      "questReceive": [
        "shiny-stones",
        "thornwood-lost-treeline"
      ],
      "favoriteGiftItemId": "spice-pouch",
      "favoriteGiftTrack": "ally",
      "dislikedGiftItemIds": [
        "butterfly"
      ]
    },
    {
      "id": "ranger-sable",
      "name": "Ranger Sable",
      "dialogueTree": "ranger-sable-trade",
      "sprite": "hub-npc-guard",
      "tx": 15,
      "ty": 25,
      "dialogue": [
        "Second ranger of Thornwood, for what the title's worth. Mostly I count wolves and hope the number stays the same.",
        "The pack's been bold since the bad winter. Wards along the treeline keep them honest — when someone bothers to set them.",
        "Forage what you can. The forest feeds the fire and the fire feeds us."
      ],
      "conversationTopics": ["thornwoodcamp-ranger-sable-topic-auto-1", "thornwoodcamp-ranger-sable-topic-auto-2", "thornwoodcamp-ranger-sable-topic-auto-3"],
      "questGive": "thornwood-forage-mushrooms",
      "questReceive": [
        "thornwood-forage-mushrooms",
        "thornwood-wolf-watch",
        "thornwood-wolf-watch-2"
      ],
      "favoriteGiftItemId": "hearty-pie",
      "favoriteGiftTrack": "ally",
      "dislikedGiftItemIds": [
        "tin-whistle"
      ]
    },
    {
      "id": "trader-pell",
      "name": "Trader Pell",
      "sprite": "hub-npc-trader",
      "tx": 5,
      "ty": 30,
      "dialogue": [
        "Just passing through — Ironhold to the river and back, if the road allows.",
        "A camp like this is worth more than a city to a traveller caught after dark. I never forget a warm fire.",
        "If you're headed Ravenwatch way, I've a parcel needs honest hands. Pays well, asks little."
      ],
      "conversationTopics": ["thornwoodcamp-trader-pell-topic-auto-1", "thornwoodcamp-trader-pell-topic-auto-2", "thornwoodcamp-trader-pell-topic-auto-3"],
      "questGive": "thornwood-travellers-aid",
      "questReceive": [
        "thornwood-travellers-aid",
        "thornwood-river-relay"
      ],
      "favoriteGiftItemId": "river-glass",
      "favoriteGiftTrack": "ally",
      "dislikedGiftItemIds": [
