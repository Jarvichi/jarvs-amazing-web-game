  "npcs": [
    {
      "id": "elder",
      "name": "The Elder",
      "sprite": "hub-npc-elder",
      "tx": 19, "ty": 12,
      "dialogue": [
        "The roads beyond the outer walls grow darker by the day. Tread carefully, wanderer.",
        "I remember when this courtyard was full of laughter. The Fracture changed everything.",
        "There is strength in preparation. Make sure your deck is ready before you venture out."
      ]
    },
    {
      "id": "merchant",
      "name": "Vex the Merchant",
      "sprite": "hub-npc-merchant",
      "tx": 22, "ty": 24,
      "dialogue": [
        "Business has been slow since the Fracture. Come back when the trade routes are safe again.",
        "I once traded with caravans from the eastern reaches. Those days feel like a dream now.",
        "Keep your coin close, wanderer. Not everyone in this town has honest intentions."
      ]
    },
    {
      "id": "scholar",
      "name": "Archivist Naia",
      "sprite": "hub-npc-scholar",
      "tx": 56, "ty": 9,
      "dialogue": [
        "I have been cataloguing the Fracture shards. The answers are within your reach — if you dare.",
        "The archives hold centuries of knowledge. Most of it was lost in the Fracture. What remains is precious.",
        "Do not underestimate the power of knowing your enemy, Commander."
      ]
    },
    {
      "id": "fisherman",
      "name": "Old Greyfish",
      "sprite": "hub-npc-fisherman",
      "tx": 3, "ty": 35,
      "dialogue": [
        "Been sitting at this pond since before the Fracture. The water's gone quiet lately — something's stirring beneath.",
        "I pulled out a strange glowing fish last week. Threw it back — some things are better left undisturbed.",
        "Patience, wanderer. The best things in life take time."
      ]
    },
    {
      "id": "dealer",
      "name": "Vince the Dealer",
      "sprite": "hub-npc-dealer",
      "tx": 64, "ty": 26,
      "screen": "casino",
      "dialogue": [
        "The wheel never lies. Step right up — fortune favours the bold.",
        "I've seen a thousand players. The ones who win? They trust their instincts.",
        "One spin, one chance. What do you say, friend?"
      ]
    },
    {
      "id": "campaign-gate",
      "name": "Campaign Gate",
      "sprite": "hub-npc-gate",
      "tx": 37, "ty": 16,
      "screen": "title",
      "dialogue": ["The battle awaits, Commander. Are you ready?"]
    },
    {
      "id": "quickbattle-gate",
      "name": "Quick Battle",
      "sprite": "hub-npc-gate",
      "tx": 37, "ty": 32,
      "screen": "quickbattle",
      "dialogue": ["Step forward for a swift engagement, Commander."]
    },
    {
      "id": "minigames-npc",
      "name": "Minigame Host",
      "sprite": "hub-npc-merchant",
      "tx": 50, "ty": 24,
      "screen": "minigames",
      "dialogue": ["Welcome to the games quarter! Try your luck."]
    },
    {
      "id": "commander-post",
      "name": "Commander's Post",
      "sprite": "hub-npc-elder",
      "tx": 37, "ty": 24,
      "screen": "commander",
      "dialogue": ["Your forces await your orders, Commander."]
    },
    {
      "id": "gildwyn",
      "name": "Gildwyn",
      "sprite": "hub-npc-card-shop",
      "building": "card-shop",
      "tx": 5, "ty": 5,
      "screen": "shop-cards",
      "dialogue": [
        "Welcome to my emporium! Finest cards in the realm.",
        "I just got a new shipment in. Take a look!",
        "Every card tells a story, wanderer."
      ]
    },
    {
      "id": "mira",
      "name": "Mira the Enchantress",
      "sprite": "hub-npc-augment-shop",
      "building": "augment-shop",
      "tx": 5, "ty": 5,
      "screen": "shop-augments",
      "dialogue": [
        "Enchantments can turn the tide of battle. Let me show you.",
        "The art of augmentation is older than the Fracture itself.",
        "I sense great potential in you, wanderer. Let's refine it."
      ]
    },
    {
      "id": "bramble",
      "name": "Bramble",
      "sprite": "hub-npc-supplies",
      "building": "supply-shop",
      "tx": 5, "ty": 5,
      "screen": "shop-supplies",
      "dialogue": [
        "Got everything you need right here. Reliable gear, fair prices.",
        "Stock up before you head out — the roads aren't safe.",
        "I've been supplying adventurers for thirty years. I know what keeps folks alive."
      ]
    },
    {
      "id": "trader",
      "name": "The Junk Trader",
      "sprite": "hub-npc-trader",
      "building": "trader-den",
      "tx": 5, "ty": 4,
      "screen": "shop-supplies",
      "dialogue": [
        "One person's junk is another's treasure. Have a rummage!",
        "I found this stuff all over the Fracture zones. Don't ask how.",
        "Make me an offer — I'm always looking to deal."
      ]
    },
    {
      "id": "naia-interior",
      "name": "Archivist Naia",
      "sprite": "hub-npc-scholar",
      "building": "scholars-hall",
      "tx": 6, "ty": 5,
      "screen": "codex",
      "dialogue": [
        "Ah, you found the hall. The codex is yours to study.",
        "Knowledge is power, Commander. Read carefully.",
        "The Fracture left many mysteries. Perhaps you can solve them."
      ]
    },
    {
      "id": "achievements-keeper",
      "name": "The Chronicler",
      "sprite": "hub-npc-elder",
      "tx": 56, "ty": 19,
      "screen": "hall-of-achievements",
      "dialogue": ["Your deeds are recorded here, Commander. Come see your legacy."]
    },
    {
      "id": "home-shelf",
      "name": "Your Quarters",
      "sprite": "hub-npc-gate",
      "tx": 19, "ty": 18,
      "screen": "home-shelf",
      "dialogue": ["A place to rest and reflect, Commander."]
    },
    {
      "id": "fishing-hole",
