#!/bin/sh
# Prevent committing package-lock.json changes without a corresponding package.json change.
# This guards against cloud/container sessions where `npm install` regenerates the lock
# file with a different npm version, which breaks CI caching.

if git diff --cached --name-only | grep -q "web/package-lock.json"; then
  if ! git diff --cached --name-only | grep -q "web/package.json"; then
    echo ""
    echo "ERROR: web/package-lock.json is staged but web/package.json is not."
    echo "Do not commit package-lock.json changes generated by npm install in a"
    echo "cloud/container session. Restore it first:"
    echo ""
    echo "  git restore web/package-lock.json"
    echo ""
    exit 1
  fi
fi
